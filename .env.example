# Bu dosyayı ".env" adıyla kopyalayıp doldurun: cp .env.example .env
# .env dosyasını ASLA paylaşmayın veya GitHub'a yüklemeyin.

# Sitenin alan adı (yerelde denemek için: localhost)
ALAN_ADI=ornek.com
# Site adresi (https ile, sonunda / olmadan)
SITE_URL=https://ornek.com
# Üretimde true: oturum çerezi yalnızca HTTPS ile gider
OTURUM_HTTPS=true

# En az 32 rastgele karakter. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Kısa ya da "degistir" kalırsa yönetici paneli KİLİTLİ kalır.
SECRET_KEY=degistir

ADMIN_KULLANICI=admin
# python -m app.cli sifre-olustur çıktısı (tek tırnaklar dahil)
ADMIN_SIFRE_HASH=''

# Veritabanı şifresi: rastgele, harf ve rakamdan oluşan uzun bir şey (özel karakter kullanmayın)
POSTGRES_PASSWORD=degistir

# API'den gizlenecek kaynak kodları (JSON listesi), örn: ["ornek"]
API_HARIC_KAYNAKLAR=[]
ISTEK_SINIRI=60/minute

# Aktarım yapılabilecek kaynaklar (JSON listesi). Bir site itiraz ederse buradan çıkarın.
# Haber kaynakları: hurriyet, sabah. aa, trt isterseniz ekleyin.
KAYNAK_IZINLERI=["egm","sg","kahramanlar","sehitlerimiz","hurriyet","sabah"]

# Açıkken: 12 saatte bir sehitlerimiz.org.tr'de yeni kayıt aranır, 30 dakikada bir de toplayıcı çalışır
# (docker-compose bunu zaten true yapar).
# Yerelde kapalı kalsın; yalnızca tek uygulama süreci olan sunucuda açılır.
ZAMANLAYICI_AKTIF=false

# Haber analizi (Claude API). Boşsa haber analizi yapılmaz.
ANTHROPIC_API_KEY=
# Günlük en fazla kaç haber analiz edilir
GUNLUK_ANALIZ_SINIRI=200
